+// Temporary diagnostic; default builds do not evaluate event strings or open files.
+enum ZoomTrace {
+    static func event(_ message: @autoclosure () -> String) {
+        #if SFV_ZOOM_DIAGNOSTICS
+        sink.write(message())
+        #endif
+    }
+
+    #if SFV_ZOOM_DIAGNOSTICS
+    private static let sink = Sink()
+
+    private final class Sink: @unchecked Sendable {
+        private let lock = NSLock()
+        private var handle: FileHandle?
+        private var count = 0
+
+        init() {
+            let path = "/private/tmp/sfv-zoom-events-\(ProcessInfo.processInfo.processIdentifier).log"
+            if FileManager.default.createFile(atPath: path, contents: nil) {
+                handle = FileHandle(forWritingAtPath: path)
+            }
+        }
+
+        func write(_ message: String) {
+            lock.lock()
+            defer { lock.unlock() }
+            guard count <= 30_000 else { return }
+            let text = count == 30_000 ? "TRACE-LIMIT" : message
+            count += 1
+            let line = "\(ProcessInfo.processInfo.systemUptime) event=\(count) \(text)\n"
+            do { try handle?.write(contentsOf: Data(line.utf8)) }
+            catch { handle = nil }
+        }
+    }
+    #endif
+}
